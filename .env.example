# Nebius Token Factory / Hosted Inference API
# Get your API key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Primary NVIDIA open model available on Nebius
NEBIUS_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Backend Server Configuration
PORT=3001
HOST=localhost
DEMO_MODE=false

# Safety and Ingestion Limits
MAX_REPO_FILES=500
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_MB=5
ANALYSIS_TIMEOUT_MS=60000
TEST_EXECUTION_TIMEOUT_MS=60000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3001
